SELECT * FROM users;

SELECT id, email, first_name, last_name, created_at
FROM users;

SELECT * FROM transaction;

SELECT
    id,
    amount,
    type,
    description,
    transaction_date,
    owner_id
FROM transaction
ORDER BY transaction_date DESC;



SELECT *
FROM transaction
WHERE type = 'expense';

SELECT *
FROM transaction
WHERE type = 'income';

SELECT COALESCE(SUM(amount), 0) AS total_income
FROM transaction
WHERE type = 'income';

SELECT COALESCE(SUM(amount), 0) AS total_expense
FROM transaction
WHERE type = 'expense';

SELECT
    COALESCE(SUM(
        CASE
            WHEN type = 'income' THEN amount
            WHEN type = 'expense' THEN -amount
            ELSE 0
        END
    ), 0) AS balance
FROM transaction;

SELECT * FROM categories;

SELECT *
FROM categories
ORDER BY name ASC;

SELECT COUNT(*) AS total_transactions
FROM transaction;


SELECT type, COUNT(*)
FROM transaction
GROUP BY type;



